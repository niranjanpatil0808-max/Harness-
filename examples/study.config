# Non-secret settings for the GitHub Actions model comparison (the key is the KINTSUGI_API_KEY secret).
# Pushing a change to this file starts the run. With STUDY_MODELS empty it makes no model calls at all.
# Each model costs roughly 20 to 40 calls per repeat; keep the list short, and mind your provider's daily token limits.
KINTSUGI_BASE_URL=https://api.groq.com/openai/v1
KINTSUGI_MAX_TOKENS=3000
STUDY_MODELS=
STUDY_REPEATS=1
STUDY_MAX_CALLS=120
