# Non-secret settings for the GitHub Actions workspace smoke test (the key is the KINTSUGI_API_KEY secret).
# Pushing a change to this file starts the run. It uses a different model from the benchmark so it does not
# spend the daily token quota of the models the benchmark uses (allam-2-7b has its own, larger one).
KINTSUGI_BASE_URL=https://api.groq.com/openai/v1
KINTSUGI_MODEL=allam-2-7b
KINTSUGI_MAX_TOKENS=3000
SMOKE_REPEATS=3
# run 2: parser now accepts tool calls written without the code fence
# run 3: cleaner prompt, fabricated-line stripping, promise nudge, evidence-based checks (tool really ran)
