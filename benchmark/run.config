# Non-secret settings for the GitHub Actions benchmark run (the key is the KINTSUGI_API_KEY secret).
# Pushing a change to this file starts the run.
KINTSUGI_BASE_URL=https://api.groq.com/openai/v1
# One run per entry, in order: "model:max_tokens[:repeats]". Groq counts max_tokens as part of every
# request against the per-minute token limit (8000 for gpt-oss-20b), so keep it well below that.
RUNS=("openai/gpt-oss-20b:4096:2" "qwen/qwen3.8-27b:6000:1")
# Which modes to run (space separated).
MODES="baseline loop loop+memory full"
REPEATS=1
SLEEP=2
# run 5: bounded retry context, API errors retried/not scored, max_tokens below the per-minute limit
