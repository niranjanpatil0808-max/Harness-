# Non-secret settings for the GitHub Actions benchmark run (the key is the KINTSUGI_API_KEY secret).
# Pushing a change to this file starts the run.
KINTSUGI_BASE_URL=https://api.groq.com/openai/v1
# One run per entry, in order: "model|max_tokens|repeats|modes|temperature|extra_json|split" (all after max_tokens optional).
# Groq counts max_tokens as part of every request against the per-minute token limit (8000 for gpt-oss-20b).
RUNS=('openai/gpt-oss-20b|4096|3|loop|0.6|{"reasoning_effort":"low"}' 'openai/gpt-oss-20b|3072|1|baseline,loop,loop+graph|0.6|{"reasoning_effort":"low"}|split_scale.json' 'allam-2-7b|1000|1|baseline,loop,loop+graph|0||split_scale.json' 'qwen/qwen3.8-27b|6000|1|baseline,loop,loop+graph|0||split_scale.json' 'allam-2-7b|1500|1|loop,loop+memory,full')
MODES="baseline loop loop+memory full"
REPEATS=1
SLEEP=2
# batch 1: (a) retry effect on gpt-oss-20b with LOW reasoning effort (headroom), 3 repeats at temperature 0.6;
# (b) context graph on the large-project suite (gpt-oss low, allam, qwen); (c) allam on the main split.
